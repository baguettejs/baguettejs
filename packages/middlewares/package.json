{
  "name": "@baguettejs/middlewares",
  "version": "1.0.0",
  "type": "module",
  "description": "Utility functions for the BaguetteJS framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
